FROM python:3.12-slim-bookworm

ARG UI_PORT=8080

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/ui/.venv

COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /usr/local/bin/

WORKDIR /ui

COPY pyproject.toml uv.lock ./
COPY src/ui/pyproject.toml src/ui/pyproject.toml

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --package eos-ui

COPY src/ui ./src/ui

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package eos-ui

RUN useradd -r -M uiuser && chown -R uiuser:uiuser /ui
USER uiuser

ENV HOME="/ui" \
    PATH="/ui/.venv/bin:$PATH"

EXPOSE ${UI_PORT}
CMD ["python", "-m", "src.ui.main"]
